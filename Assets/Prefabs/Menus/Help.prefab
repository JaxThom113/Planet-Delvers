  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "How to Start a game\n\nLength = How large a world generates/how long it
    takes to complete\n    - small = 16x16 world, 20 minutes\n    - medium = 24x24
    world, 40 minutes\n    - long = 32x32 world, 1 hour\n\nLevel = difficulty rating
    of a world, tells how many enemies spawn and what damage they deal\n    - easy
    = fewer enemies, less damage\n    - standard = normal enemy count, base damage\n   
    - hard = more enemies, higher damage\n\nSeed = if enabled, you can play a specific
    world defined by a seed\n\nHow to Play\n\nWhen you launch, you will be placed
    in a randomly generated word in a random cell\n\n1. First you must explore the
    first accessible area and find and defeat its boss to acquire your first ability\n\n2.
    After getting your first random ability, it will enable you to acess the second
    area for your world\n\n3. From there, defeat the second boss and get the second
    ability, proceed to the third area, and repeat until tou complete area 4\n\n4.
    After completing the fourth and final area, your job is complete and you can
    extract\n\n5. When you extract, you have a set timer to reach a random room to
    catch your escape ship before it leaves - make sure to get there on time!\n\nOnce
    you make it to the escape ship, you have succeeded on your mission!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e900895e2b2ef94e89e860b3f9a502b, type: 2}
  m_sharedMaterial: {fileID: 7426419192688551808, guid: 2e900895e2b2ef94e89e860b3f9a502b, type: 2}
